# HexFutures-AI 环境变量模板（切勿提交真实凭据）
# 复制为 .env 并填入本地值

# ---------- 目录 ----------
HEXBROKER_ROOT=E:/Workspace/HexBroker
DATA_DIR=E:/Workspace/HexBroker/data
ARTIFACTS_DIR=E:/Workspace/HexBroker/artifacts

# ---------- 天勤 TQSDK（可选，留接口暂不接） ----------
TQSDK_USERNAME=
TQSDK_PASSWORD=

# ---------- Kronos 权重（可选，缺失则回退 ARTransformer） ----------
KRONOS_LOCAL_DIR=E:/Workspace/HexBroker/third_party/weights
HUGGINGFACE_HUB_OFFLINE=false

# ---------- 实盘（默认关闭，需 --i-understand-the-risk） ----------
CTP_BROKER_ID=
CTP_USER_ID=
CTP_PASSWORD=
SIMNOW_FRONT_ADDRESS=tcp://180.168.146.187:10201
